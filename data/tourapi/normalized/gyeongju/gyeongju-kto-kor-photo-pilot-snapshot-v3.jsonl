mage2_1.JPG", "kto_images": [{"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/40/3507140_image2_1.JPG"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/42/3507142_image2_1.JPG"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/44/3507144_image2_1.jpg"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/45/3507145_image2_1.jpg"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/46/3507146_image2_1.jpg"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/47/3507147_image2_1.jpg"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/48/3507148_image2_1.jpg"}, {"rights": "RIGHTS_EVIDENCE_MISSING", "url": "https://tong.visitkorea.or.kr/cms/resource/49/3507149_image2_1.jpg"}], "kto_intro": {"accomcount": "", "chkbabycarriage": "", "chkcreditcard": "", "chkpet": "", "contentid": "128676", "contenttypeid": "12", "expagerange": "", "expguide": "", "heritage1": "0", "heritage2": "0", "heritage3": "0", "infocenter": "경주시청 관광컨벤션과 054-779-6830~4", "opendate": "", "parking": "가능", "restdate": "연중무휴", "useseason": "", "usetime": "상시 개방"}, "kto_mapx": "129.214693367401", "kto_mapy": "35.8296308266303", "kto_match_status": "EXACT_MATCH", "kto_overview": "경주 교촌마을은 신라 신문왕 2년(682)에 설립된 신라 최초의 국립대학인 ‘국학’이 있던 곳이다. 이 교육기관은 시대에 따라 변화하며 고려시대에는 향학, 조선시대에는 향교로 이어졌다. 마을 이름이 교동, 교촌, 교리 등으로 불린 것도 모두 향교가 있던 곳이라는 사실에서 비롯된다. 마을 주변에는 삼국유사 속 이야기보따리가 곳곳에 숨겨져 있다. 김알지가 태어난 계림, 원효스님과 요석공주의 사랑을 이어준 문천교(蚊川橋) 터, 김유신이 살던 재매정, 월정교와 충담스님, 도화녀를 사랑한 진지왕, 선덕여왕이 만든 첨성대 등 수많은 이야기의 흔적이 교촌과 남천을 따라 펼쳐져 있다. 최부자 고택을 중심으로 향교와 전통한옥이 많이 남아있으며 가까운 곳에 월성, 월정교, 첨성대, 계림, 고분 등 소중한 신라유적이 있어 신라 문화 속의 조선 문화가 공존하는 특별한 곳이다. 또한 새롭게 복원·조성되어 문화유적의 원형을 잘 보존하면서도 관광객이 보고 즐길 수 있는 관광지로 거듭났으며 국내 최대 규모의 목조 교량인 월정교가 복원되어 목조건축의 웅장함을 느낄 수 있다. 또한 야간에는 화려한 조명으로 또 다른 볼거리를 제공해 많은 관광객이 찾는 야경 코스가 되었다.", "name_ko": "교촌마을", "vg_coord_in_range": true, "vg_coord_type": "OFFICIAL_PAGE_MAP_POINT", "vg_lat": 35.82963305348067, "vg_lng": 129.2146961439045}
