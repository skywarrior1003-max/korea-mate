					var AirPollutionColor = "#1a549d";


					if(pm10 >= 31 && pm10 <= 80){
						pm10Value = "보통"; AirPollutionColor = "#52a644";
					}else if (pm10 >= 81 && pm10 <= 150)
					{
						pm10Value = "나쁨"; AirPollutionColor = "#f0802e";
