}else if (curDate >= 12 &&  curDate < 15){
	fcsttime = '1800';
}else if (curDate >= 15 &&  curDate < 18){
	fcsttime = '2100';
}else if (curDate >= 18 &&  curDate < 21){
	fcsttime = '2100';
}else if (curDate >= 21 &&  curDate < 24){
	fcsttime = '2100';
}else {
	fcsttime = '0300';
}
