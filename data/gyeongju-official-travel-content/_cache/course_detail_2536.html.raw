if( curDate < 3 ){
	fcsttime = '0600';
}else if (curDate >= 3 &&  curDate < 6){
	fcsttime = '0900';
}else if (curDate >= 6 &&  curDate < 9){
	fcsttime = '1200';
}else if (curDate >= 9 &&  curDate < 12){
