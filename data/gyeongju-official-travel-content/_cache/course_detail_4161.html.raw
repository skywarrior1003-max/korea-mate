		if(sky == 6 || sky == 7 ||sky == 8 ) Src = "3-구름많음";		// 구름많음
		if(sky == 9 || sky == 10) Src = "4-흐림";							// 흐림
		if(sky == "null" ) Src = "1-맑음";
	}else{
		if( pty == 1 ) Src = "5-비";			//비
		if( pty == 2 ) Src = "6-비/눈";		//비/눈
