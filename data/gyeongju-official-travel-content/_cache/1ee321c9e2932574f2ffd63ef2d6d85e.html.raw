<script>
      $(document).ready(function () {
        $(function () {
          var popup_btn = $('.pr-btn');
          // var popup_close = $('.pr-popup').find('.pr_close');
          var popup_close = $('.pr_close');

          popup_btn.on("click", function () {

            $('html').addClass('noScroll');
            var popup = $(this).next('.pr-popup');
            var isActive = $(this).is('.active');

            if (!isActive) {
              $(this).addClass('active');

            }
            return false;
          });

          popup_close.on('click', function () {
            $('html').removeClass('noScroll');
            $(this).parents('.wrap').parents('.pr-popup').prev('.pr-btn').removeClass('active');
            return false;
          });
        });
      });
    </script>

