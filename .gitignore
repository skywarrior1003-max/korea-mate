# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright 산출물 (스크린샷·리포트 — 기본 커밋 금지)
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — do NOT commit)
.env
.env.local
.env.*.local
.admin_key_temp
.dev.vars
# .env.example is intentionally committed as a template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp files (auto-generated by supabase link/query — may contain sensitive DB URLs)
supabase/.temp/

# Wrangler local dev artifacts (auto-regenerated on every wrangler dev/pages dev run)
.wrangler/

# TASK QA/evidence 작업 폴더 — 스크린샷·acceptance html·privacy scan 등.
# 태스크 프로토콜상 tmp evidence 는 커밋 금지라 repo 에 tracked 파일이 0 임을
# 확인하고 전체를 ignore 한다(SOURCE-CONTROL-HYGIENE-AUDIT-V1, 2026-09-09).
# repo 에 남겨야 할 산출물은 docs/ 또는 data/ 로 옮겨 커밋한다.
/tmp/

# TourAPI research outputs (위 /tmp/ 에 포함되지만 역사적 명시 유지)
tmp/tourapi-pilot/
tmp/tourapi-nightly/

# TourAPI 대용량 산출물 (배치 raw, 스냅샷, 정규화 JSON)
data/tourapi/raw/
data/tourapi/snapshots/
data/tourapi/normalized/**/*-batch-normalized.json

# python 캐시 (scripts/main-intake 등 — 생성물, 커밋 금지)
__pycache__/
*.pyc
